{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "**/.*",
      ".git/**",
      ".git",
      ".claude/**",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "README.md",
      "CLAUDE.md",
      "ACL.md",
      "leaveeasy-spec.md",

      "js/config.local.js",
      "js/config.local.json",
      "js/secrets.js",
      "js/secrets.json",
      "*serviceAccount*.json",
      "firebase-adminsdk*.json",
      "*.pem",
      "*.key",
      "*.p12",
      "*.p8",
      "credentials.json",

      "playwright.config.js",
      "tests/**",
      "test-results/**",
      "playwright-report/**"
    ]
  }
}
